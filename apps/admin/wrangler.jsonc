{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hilltop-admin",
  // The account comes from CLOUDFLARE_ACCOUNT_ID (a CI variable), not this file.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hilltop-admin" }],
  // Listing photos, so deleting an account removes them too.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "hilltop-photos" }],
  // Secrets set in the Cloudflare dashboard (Settings → Variables and Secrets):
  //   SUPABASE_SECRET_KEY  lets /api/users/[id] delete accounts.
  "routes": [{ "pattern": "admin.hilltop.lumavok.com", "custom_domain": true }],
  // Deploys replace the Worker's variables with these, so they live here, not only in the dashboard.
  "vars": {
    // Sentry reads the DSN from here and the release from the version metadata.
    "SENTRY_DSN": "https://aa160f658007a70234883d5280ef854f@o4509836470386688.ingest.us.sentry.io/4512357467947008",
    // The Worker checks Cloudflare Access's token on every request too, so the portal
    // stays closed if Access is ever switched off by mistake (access.ts, docs/RUNBOOK.md).
    // The AUD tag is the admin Access application's (Zero Trust → Access → Applications).
    "CF_ACCESS_TEAM_DOMAIN": "lumavok.cloudflareaccess.com",
    "CF_ACCESS_AUD": "1bf22feecf5450dad768528419b84dc9151db83863557cd8a9a384ad3364607f",
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
}
