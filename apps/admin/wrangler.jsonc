{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hilltop-admin",
  "account_id": "5355b49c1a233e2cb0db485b587408fd",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hilltop-admin" }],
  // Secrets (set in the dashboard or with `wrangler secret put`): ADMIN_ACCESS_KEY
  "routes": [{ "pattern": "admin.hilltop.lumavok.com", "custom_domain": true }],
  // Sentry reads the DSN from here and the release from the version metadata.
  "vars": { "SENTRY_DSN": "https://aa160f658007a70234883d5280ef854f@o4509836470386688.ingest.us.sentry.io/4512357467947008" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
}
