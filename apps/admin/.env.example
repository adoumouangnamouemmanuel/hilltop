# Supabase project (public values). For local development use the values printed by
# `npx supabase start`; production values live in .env.production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Link from the admin portal to the marketplace.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
# Server only, never NEXT_PUBLIC: lets admins delete accounts. Locally, the secret key
# printed by `npx supabase status`; in production a Worker secret.
SUPABASE_SECRET_KEY=
