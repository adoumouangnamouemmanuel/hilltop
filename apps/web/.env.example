# Supabase project (public values). For local development use the values printed by
# `npx supabase start`; production values live in .env.production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "azure" (Microsoft) or "google" once the school's sign-in is configured in Supabase.
NEXT_PUBLIC_SSO_PROVIDER=

# Browser push registration; the matching private key stays on the Worker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Worker secrets (or local server-only values when testing push delivery).
SUPABASE_SECRET_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
# Explicit test-only fallback; accepted only for localhost/127.0.0.1 uploads.
ALLOW_MEMORY_PHOTOS=false
