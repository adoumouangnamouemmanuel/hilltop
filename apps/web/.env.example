# Supabase project (public values). For local development use the values printed by
# `npx supabase start`; production values live in .env.production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "azure" (Microsoft) or "google" once the school's sign-in is configured in Supabase.
NEXT_PUBLIC_SSO_PROVIDER=
